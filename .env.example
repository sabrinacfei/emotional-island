# FastAPI / MongoDB
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/emotion_tracker_db?retryWrites=true&w=majority
DATABASE_NAME=emotion_tracker_db
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=*

# AI
OPENAI_API_KEY=sk-your-openai-key

# Optional neural model deployment paths.
# The 888MB model checkpoint should not be committed directly to GitHub.
# Use Git LFS, Hugging Face, or cloud storage and point these variables there
# after downloading/unpacking the model on the server.
PREDICT_SCRIPT_PATH=./predict_sentence_json.py
PLUTCHIK_MODEL_DIR=./plutchik_human_poslog_data42_model17
PIPELINE_API_BASE=http://localhost:8001

# Expo build-time API URL.
# Use your deployed FastAPI HTTPS URL for EAS builds.
EXPO_PUBLIC_API_URL=https://your-emotional-island-api.onrender.com
